await (async page => {
  const identity = await (await page.request.get('http://127.0.0.1:8039/v1/acceptance-fixture')).json();
  if (!identity.synthetic) throw new Error('Synthetic fixture required');
  const goal = '核查当前用药证据与适用条件（进度验收二）';
  await page.getByRole('textbox', {name: '核查目标'}).fill(goal);
  const card = page.locator('article').filter({hasText: goal});
  const started = Date.now();
  const accepted = page.waitForResponse(r => r.url().includes('/resume') && r.request().method() === 'POST');
  await page.getByRole('button', {name: '开始核查', exact: true}).click();
  const receipt = await (await accepted).json();
  await card.getByRole('status').filter({hasText: /已受理|整理记录/}).first().waitFor({timeout: 10000});
  const firstVisibleMs = Date.now() - started;
  await page.screenshot({path: 'D:/py/HealthAssistant/output/playwright/planner-closeout-20260911/running.png', fullPage: true});
  await card.getByRole('status').filter({hasText: '本轮已暂停，等待补充记录'}).waitFor({timeout: 30000});
  const terminalMs = Date.now() - started;
  const progress = await (await page.request.get('http://127.0.0.1:8039/v1/runs/' + encodeURIComponent(receipt.active_run_id) + '/progress')).json();
  if (progress.events.at(-1).kind !== 'waiting_input') throw new Error('Missing honest waiting state');
  if (progress.events.some(e => e.kind === 'completed')) throw new Error('False completion event');
  await page.screenshot({path: 'D:/py/HealthAssistant/output/playwright/planner-closeout-20260911/waiting.png', fullPage: true});
  await page.reload();
  await card.getByRole('status').filter({hasText: '本轮已暂停，等待补充记录'}).waitFor({timeout: 15000});
  return {synthetic: true, retrievalDelaySeconds: 5, taskId: receipt.id, runId: receipt.active_run_id,
    firstVisibleMs, terminalMs, refreshPreserved: true, progress};
}
)(page);
